# Client-exposed (parity with legacy Vite) – already in your .env as VITE_DEEPGRAM_API_KEY
NEXT_PUBLIC_DEEPGRAM_API_KEY=your_40char_project_api_key

# Server-only (recommended for industrial – hides key, use /api/deepgram/tts & /api/deepgram/token)
DEEPGRAM_API_KEY=your_40char_project_api_key

# Optional override for Node-RED host (defaults to wss://node-dev.iotaiml.dpdns.org)
NEXT_PUBLIC_NODE_RED_HOST=node-dev.iotaiml.dpdns.org
NEXT_PUBLIC_NODE_RED_PROTOCOL=wss
